##############################################################
# Guardian Local Development Environment
##############################################################
# Copy this file to .env.dev and fill in the <...> values.
#
#   cp .env.dev.example .env.dev
#
# Variables with default values work out-of-the-box when
# docker-compose-dev.yml is running (MongoDB + NATS + IPFS locally).
# Variables marked with <...> REQUIRE your input.
#
# How services load this file:
# Each service calls dotenv.config() without 'override: true',
# so pre-exported shell variables take precedence.
# Source this file before running yarn dev:backend:
#
#   export $(grep -v '^#' .env.dev | xargs) && yarn dev:backend
#
# Or use direnv: https://direnv.net/
##############################################################


##############################################################
# GUARDIAN PLATFORM
##############################################################

# Name of this Guardian instance.
# Used to namespace database names: <GUARDIAN_ENV>_<HEDERA_NET>_<DB>
# Leave blank (default) to use plain DB names like "guardian_db".
GUARDIAN_ENV=


##############################################################
# HEDERA NETWORK
# Required — get credentials from https://portal.hedera.com
##############################################################

HEDERA_NET=testnet
PREUSED_HEDERA_NET=testnet

# Your Hedera testnet Account ID (e.g. 0.0.123456)
OPERATOR_ID=<>

# Your Hedera DER-encoded private key (starts with 302e020100...)
OPERATOR_KEY=<>

# Hedera topic ID for Guardian initialization.
# Leave as the testnet shared topic for first-time setup.
# After first run, paste the generated topic ID here to persist state.
INITIALIZATION_TOPIC_ID=0.0.1960

# Initial password for the Standard Registry account created on first run.
SR_INITIAL_PASSWORD=<>

MAX_HEDERA_TIMEOUT=600

# Guardian contract IDs (testnet defaults — do not change for testnet dev)
RETIRE_CONTRACT_FILE_ID=0.0.6371646
WIPE_CONTRACT_FILE_ID=0.0.6371642
RETIRE_SINGLE_FILE_ID=0.0.6371651
RETIRE_DOUBLE_FILE_ID=0.0.6371652


##############################################################
# IPFS
# Default: local Kubo node in docker-compose-dev.yml (dev-ipfs).
# No account or API key needed — works out of the box.
#
# To switch to web3.storage instead, comment out the local
# block and uncomment the web3storage block below.
##############################################################

# Options: local | web3storage | filebase
IPFS_PROVIDER=local

# --- LOCAL (default, matches docker-compose-dev.yml) ---
IPFS_NODE_ADDRESS=http://localhost:5001
IPFS_PUBLIC_GATEWAY=http://localhost:8080/ipfs/${cid}

# --- WEB3.STORAGE (uncomment if IPFS_PROVIDER=web3storage) ---
# IPFS_STORAGE_KEY=<YOUR_WEB3_STORAGE_UCAN_TOKEN>
# IPFS_STORAGE_PROOF=<YOUR_WEB3_STORAGE_DELEGATION_PROOF>
# IPFS_PUBLIC_GATEWAY=https://${cid}.ipfs.w3s.link

# Timeout in seconds for IPFS upload/download operations
IPFS_TIMEOUT=720


##############################################################
# DATABASE (MongoDB)
# Default matches docker-compose-dev.yml (dev-mongo container)
# Each service uses its own DB_DATABASE (set per-service in
# configs/.env.<service>). DB_HOST is shared.
##############################################################

DB_HOST=localhost

# Used by application-events (hardcodes 'mongo' as fallback if not set)
MONGODB_SERVER_URL=mongodb://localhost:27017

# Pino logger DB settings (shared logging database)
DB_LOGGER_NAME=logger_db
DB_LOGGER_HOST=localhost
DB_LOGGER_COLLECTION=log

# MongoDB connection pool settings
MIN_POOL_SIZE=1
MAX_POOL_SIZE=5
MAX_IDLE_TIME_MS=30000


##############################################################
# MESSAGE BROKER (NATS)
# Default matches docker-compose-dev.yml (dev-nats container)
##############################################################

# Hostname only — NATS client connects on port 4222
MQ_ADDRESS=localhost

# Max message payload in bytes (1 MB default)
MQ_MAX_PAYLOAD=1048576


##############################################################
# JWT AUTHENTICATION
# Services use an RSA key pair for JWT signing/verification.
# Generate a key pair with:
#   openssl genrsa -out jwt.pem 2048
#   openssl rsa -in jwt.pem -pubout -out jwt.pub
# Then paste the full PEM content (single-line with \n escaping)
# or set these as multi-line values in a sourced shell script.
##############################################################

JWT_PRIVATE_KEY=<YOUR_RSA_PRIVATE_KEY_PEM>
JWT_PUBLIC_KEY=<YOUR_RSA_PUBLIC_KEY_PEM>


##############################################################
# SERVICE-TO-SERVICE AUTH (inter-service JWT)
# For local dev, the _ALL variants apply one key to all
# services — simpler than setting per-service key pairs.
# Generate with: openssl rand -hex 64
##############################################################

SERVICE_JWT_SECRET_KEY_ALL=<RANDOM_HEX_SECRET_64_CHARS>
SERVICE_JWT_PUBLIC_KEY_ALL=<MATCHING_PUBLIC_KEY_OR_SAME_AS_SECRET_FOR_HS256>


##############################################################
# VAULT / KEY STORAGE
# Set VAULT_PROVIDER=database for local dev (no Vault needed).
# Keys are stored encrypted in MongoDB.
##############################################################

VAULT_PROVIDER=database

# HashiCorp Vault settings — only needed if VAULT_PROVIDER=hashicorp
HASHICORP_ADDRESS=http://localhost:8200
HASHICORP_TOKEN=<YOUR_VAULT_TOKEN>
HASHICORP_NAMESPACE=admin
HASHICORP_ENCRIPTION_ALG=sha512

# Secret Manager type — leave empty to disable (uses VAULT_PROVIDER instead)
SECRET_MANAGER=

SEND_KEYS_TO_VAULT=TRUE


##############################################################
# POLICY ENGINE
##############################################################

MESSAGE_LANG=en-US
TRANSACTION_LOG_LEVEL=1
MULTI_POLICY_SCHEDULER=0 0 * * *
GLOBAL_EVENT_TOPIC_SCHEDULER=*/30 * * * *
BBS_SIGNATURES_MODE=WASM

# Initial account balances for new Hedera accounts (in HBAR)
INITIAL_BALANCE=100
INITIAL_STANDARD_REGISTRY_BALANCE=100

# Worker task configuration
MIN_PRIORITY=0
MAX_PRIORITY=20
TASK_TIMEOUT=300
REFRESH_INTERVAL=60


##############################################################
# WORKER SERVICE — IPFS analytics endpoint (optional)
# Only needed if using the MGS indexer integration.
##############################################################

ANALYTICS_SERVICE=http://localhost:3021
# ANALYTICS_SERVICE_TOKEN=<YOUR_INDEXER_TOKEN>


##############################################################
# API GATEWAY — CACHE
# Default matches docker-compose-dev.yml (dev-cache container).
# Uses Redict (Redis-compatible) on localhost:6379.
##############################################################

ENABLE_CACHE=true
HOST_CACHE=localhost
PORT_CACHE=6379


##############################################################
# LOGGING (Pino)
# Options: CONSOLE | MONGO | FILE (comma-separated)
# LOG_LEVEL options: error | warn | info | debug
##############################################################

TRANSPORTS=CONSOLE, MONGO
LOG_LEVEL=info
LOG_FILE_PATH=


##############################################################
# AUTHENTICATION POLICY
##############################################################

ACCESS_TOKEN_UPDATE_INTERVAL=60000
REFRESH_TOKEN_UPDATE_INTERVAL=31536000000
MIN_PASSWORD_LENGTH=8
# Options: easy | medium | hard
PASSWORD_COMPLEXITY=medium


##############################################################
# REQUEST VALIDATION
##############################################################

ALLOWED_PROTOCOLS=https
BLOCK_PRIVATE_IP=false


##############################################################
# POLICY SERVICE — THIRD-PARTY INTEGRATION TOKENS (optional)
# Only needed if policies use these external data sources.
##############################################################

# KANOP_IO_AUTH_TOKEN=<YOUR_KANOP_TOKEN>
# FIRMS_AUTH_TOKEN=<YOUR_FIRMS_TOKEN>
# GLOBAL_FOREST_WATCH_API_KEY=<YOUR_GFW_KEY>


##############################################################
# OPTIONAL: INDEXER SERVICE
# Only needed when running: yarn dev:indexer
##############################################################

INDEXER_DB_HOST=localhost
INDEXER_DB_DATABASE=indexer_db
# Mirror node to sync from
SYNC_ALL_MASK=0 * * * *
START_SYNC_ALL=true
HEDERA_EXPLORER_LINK=https://hashscan.io/${network}/${type}/${value}/${subType}/${subValue}
IPFS_GATEWAY=https://ipfs.io/ipfs/${cid}
